# ============================================================
# 本番環境用環境変数テンプレート
# Railway デプロイ時にこの内容を参考に環境変数を設定してください
# ============================================================

# アプリケーション基本設定
APP_NAME="施設請求管理システム"
APP_ENV=production
APP_KEY=                      # 必須: php artisan key:generate --show で生成した値を設定
APP_DEBUG=false
APP_TIMEZONE=Asia/Tokyo
APP_URL=https://your-app.up.railway.app  # デプロイ後に Railway から割り当てられる URL を設定
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

# ログ設定
LOG_CHANNEL=stderr            # Railway のログ収集用に stderr を使用
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error               # 本番では error 以上のみ

# メンテナンスモード
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# データベース設定 (Railway PostgreSQL から自動設定されるため通常は不要)
# DATABASE_URL=postgres://user:pass@host:port/db  # Railway が自動提供
# または個別設定 (Railway が自動提供):
# DB_CONNECTION=pgsql
# DB_HOST=                        # PGHOST から自動
# DB_PORT=5432                    # PGPORT から自動
# DB_DATABASE=                    # PGDATABASE から自動
# DB_USERNAME=                    # PGUSER から自動
# DB_PASSWORD=                    # PGPASSWORD から自動
# DB_SSLMODE=require

# セッション設定
SESSION_DRIVER=database         # データベースセッション (複数インスタンス対応)
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null             # 本番ドメインを設定する場合: .your-domain.com

# キャッシュ設定
CACHE_STORE=file                # または redis (Redis サービス追加時)

# キュー設定
QUEUE_CONNECTION=sync           # または database / redis (非同期処理が必要な場合)

# ブロードキャスト
BROADCAST_CONNECTION=log

# ファイルシステム
FILESYSTEM_DISK=local           # Railway Volume 使用時は local のまま
# AWS S3 互換ストレージを使用する場合:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-northeast-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ENDPOINT=

# メール設定 (本番では SMTP 等を設定)
MAIL_MAILER=log                 # または smtp, sendmail 等
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# 施設基本情報 (必須: 実際の施設情報に書き換えてください)
# ============================================================
FACILITY_NAME="施設名"
FACILITY_OPERATOR="運営法人名"
FACILITY_POSTAL_CODE="123-4567"
FACILITY_ADDRESS="都道府県市区町村 番地"
FACILITY_PHONE="03-1234-5678"
FACILITY_FAX="03-1234-5679"
FACILITY_EMAIL="info@your-facility.jp"

# 適格請求書発行事業者登録番号 (T + 13桁数字) - 必須
FACILITY_INVOICE_NUMBER=T1234567890123

# 振込先銀行口座情報 - 必須
FACILITY_BANK_NAME="銀行名"
FACILITY_BANK_BRANCH="支店名"
FACILITY_BANK_TYPE=普通
FACILITY_BANK_NUMBER="1234567"
FACILITY_BANK_HOLDER="カ）法人名"

# 請求・支払いサイクル設定
FACILITY_DEBIT_DAY=27                   # 翌月口座振替日 (1-31)
FACILITY_TRANSFER_DUE_DAYS=30           # 支払期限日数

# ============================================================
# その他の設定
# ============================================================

# 暗号化キー (APP_KEY と同じで通常 OK)
# BCRYPT_ROUNDS=12

# Redis 設定 (Redis サービスを追加した場合)
# REDIS_HOST=
# REDIS_PASSWORD=
# REDIS_PORT=6379
# REDIS_CLIENT=phpredis

# Memcached 設定 (Memcached サービスを追加した場合)
# MEMCACHED_HOST=

# Vite / フロントエンド
VITE_APP_NAME="${APP_NAME}"

# ============================================================
# Railway 固有の自動設定される変数 (手動設定不要)
# ============================================================
# PORT=8000
# RAILWAY_STATIC_URL=https://xxx.up.railway.app
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=xxx
# RAILWAY_SERVICE_ID=xxx