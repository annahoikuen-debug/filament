# ============================================================
# 本番環境用環境変数テンプレート
# Railway デプロイ時にこの内容を参考に環境変数を設定してください
#
# 注意: dotenv は行末コメント（値の後ろに # ...）をサポートしません。
#       コメントは必ず行の先頭に # を付けて独立した行に書いてください。
# ============================================================

# アプリケーション基本設定
APP_NAME="施設請求管理システム"
APP_ENV=production
# 必須: php artisan key:generate --show で生成した値を設定
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tokyo
# デプロイ後に Railway から割り当てられる URL を設定
APP_URL=https://your-app.up.railway.app
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

# ログ設定
# Railway のログ収集用に stderr を使用
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 本番では error 以上のみ
LOG_LEVEL=error

# メンテナンスモード
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# データベース設定 (Railway PostgreSQL から自動設定されるため通常は不要)
# DATABASE_URL=postgres://user:pass@host:port/db
# または個別設定 (Railway が自動提供):
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require

# セッション設定
# データベースセッション (複数インスタンス対応)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# HTTPS 前提: Secure フラグ付き Cookie
SESSION_SECURE_COOKIE=true
# JavaScript からの Cookie アクセスを禁止
SESSION_HTTP_ONLY=true
# CSRF 対策
SESSION_SAME_SITE=lax
SESSION_PATH=/
# 本番ドメインを設定する場合: .your-domain.com
SESSION_DOMAIN=null

# キャッシュ設定
# または redis (Redis サービス追加時)
CACHE_STORE=file

# キュー設定
# または database / redis (非同期処理が必要な場合)
QUEUE_CONNECTION=sync

# ブロードキャスト
BROADCAST_CONNECTION=log

# ファイルシステム
# Railway Volume 使用時は local のまま
FILESYSTEM_DISK=local
# AWS S3 互換ストレージを使用する場合:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-northeast-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ENDPOINT=

# メール設定 (本番では SMTP 等を設定)
# または smtp, sendmail 等
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# 施設基本情報 (必須: 実際の施設情報に書き換えてください)
# ============================================================
FACILITY_NAME="施設名"
FACILITY_OPERATOR="運営法人名"
FACILITY_POSTAL_CODE="123-4567"
FACILITY_ADDRESS="都道府県市区町村 番地"
FACILITY_PHONE="03-1234-5678"
FACILITY_FAX="03-1234-5679"
FACILITY_EMAIL="info@your-facility.jp"

# 適格請求書発行事業者登録番号 (T + 13桁数字) - 必須
FACILITY_INVOICE_NUMBER=T1234567890123

# 振込先銀行口座情報 - 必須
FACILITY_BANK_NAME="銀行名"
FACILITY_BANK_BRANCH="支店名"
FACILITY_BANK_TYPE=普通
FACILITY_BANK_NUMBER="1234567"
FACILITY_BANK_HOLDER="カ）法人名"

# 請求・支払いサイクル設定
# 翌月口座振替日 (1-31)
FACILITY_DEBIT_DAY=27
# 支払期限日数
FACILITY_TRANSFER_DUE_DAYS=30

# ============================================================
# その他の設定
# ============================================================

# 暗号化キー (APP_KEY と同じで通常 OK)
# BCRYPT_ROUNDS=12

# Redis 設定 (Redis サービスを追加した場合)
# REDIS_HOST=
# REDIS_PASSWORD=
# REDIS_PORT=6379
# REDIS_CLIENT=phpredis

# Memcached 設定 (Memcached サービスを追加した場合)
# MEMCACHED_HOST=

# Vite / フロントエンド
VITE_APP_NAME="${APP_NAME}"

# ============================================================
# Railway 固有の自動設定される変数 (手動設定不要)
# ============================================================
# PORT=8000
# RAILWAY_STATIC_URL=https://xxx.up.railway.app
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=xxx
# RAILWAY_SERVICE_ID=xxx
