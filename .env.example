APP_NAME=施設請求管理システム
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost:8000
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# Session Security（本番環境では SESSION_SECURE_COOKIE=true / SESSION_ENCRYPT=true を推奨）
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# 施設基本情報（config/facility.php のオーバーライド用）
FACILITY_NAME="ケアレジデンス ひまわり"
FACILITY_OPERATOR=株式会社ひまわりケア
FACILITY_POSTAL_CODE=123-4567
FACILITY_ADDRESS="東京都〇〇区〇〇町 1-2-3"
FACILITY_PHONE=03-1234-5678
FACILITY_FAX=03-1234-5679
FACILITY_EMAIL=info@care-himawari.example.jp
# 適格請求書発行事業者登録番号（T + 13桁数字）
FACILITY_INVOICE_NUMBER=T1234567890123
FACILITY_BANK_NAME=〇〇銀行
FACILITY_BANK_BRANCH=〇〇支店
FACILITY_BANK_TYPE=普通
FACILITY_BANK_NUMBER=1234567
FACILITY_BANK_HOLDER=カ）ヒマワリケア
FACILITY_DEBIT_DAY=27
FACILITY_TRANSFER_DUE_DAYS=30

# DailyCharge Observer Settings
DAILY_CHARGE_NOTIFICATION_MAIL_TO="admin@care-himawari.example.jp"
DAILY_CHARGE_OBSERVER_LOG_LEVEL="info"

# ============================================================
# Sentry エラー追跡 (本番環境で SENTRY_LARAVEL_DSN を設定して有効化)
# 未設定の場合は無効化され、例外はログチャネルにのみ出力されます
# ============================================================
SENTRY_LARAVEL_DSN=
SENTRY_LARAVEL_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ============================================================
# オペレーション監視・アラート設定
# ============================================================
OPS_ALERT_ENABLED=false
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_EMAILS=
OPS_ALERT_COOLDOWN_SECONDS=3600

# ============================================================
# 二要素認証 (2FA) 設定
# mode: off(不強制) / admins(管理者のみ強制) / all(全ユーザー強制)
# ============================================================
TWO_FACTOR_MODE=off
