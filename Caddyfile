{
    admin off
    # HTTP/2 and HTTP/3 enabled by default
}

:8000 {
    root * /app/public
    encode zstd gzip

    # PHP server - single worker for memory efficiency
    php_server {
        # Worker count controlled via env: FRANKENPHP_PHP_SERVER_WORKERS=1
    }

    # Security headers
    header {
        # HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent MIME sniffing
        X-Content-Type-Options "nosniff"
        # Clickjacking protection
        X-Frame-Options "SAMEORIGIN"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # XSS protection
        X-XSS-Protection "1; mode=block"
        # Permissions policy
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Static files
    @static {
        file
        not path *.php
    }

    handle @static {
        file_server {
            # Cache static assets for 1 year
            header Cache-Control "public, max-age=31536000, immutable"
        }
    }

    # PHP files
    @php {
        path *.php
    }

    handle @php {
        php_server
    }

    # Fallback to PHP for Laravel routing
    handle {
        php_server
    }

    # Logging
    log {
        output stdout
        format json
        level INFO
    }

    # Error pages
    errors {
        404 /index.php
        500 /index.php
    }
}

# Health check endpoint
:8000 {
    @health {
        path /up
    }
    handle @health {
        respond "OK" 200
    }
}