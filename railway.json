{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "frankenphp run --config /etc/frankenphp/Caddyfile",
    "healthcheckPath": "/up",
    "healthcheckTimeout": 300,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1,
    "env": {
      "FRANKENPHP_PHP_SERVER_WORKERS": "1",
      "FRANKENPHP_PHP_SERVER_MAX_REQUESTS": "500"
    }
  }
}